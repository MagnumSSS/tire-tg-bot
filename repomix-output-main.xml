package ru.azenizzka.telegram.handlers;

import java.util.List;
import org.springframework.stereotype.Component;
import org.telegram.telegrambots.meta.api.methods.send.SendMessage;
import org.telegram.telegrambots.meta.api.objects.Update;
import ru.azenizzka.entities.Person;
import ru.azenizzka.services.BellScheduleService;
import ru.azenizzka.services.LessonScheduleService;
import ru.azenizzka.telegram.keyboards.MainKeyboard;
import ru.azenizzka.telegram.keyboards.ReportKeyboard;
import ru.azenizzka.telegram.messages.CustomMessage;
import ru.azenizzka.telegram.messages.ErrorMessage;
import ru.azenizzka.utils.Day;
import ru.azenizzka.utils.DayUtil;
import ru.azenizzka.utils.MessagesConfig;

@Component
public class RecessHandler implements Handler {

  private final LessonScheduleService lessonScheduleService;
  private final BellScheduleService bellScheduleService;

  public RecessHandler(
      LessonScheduleService lessonScheduleService, BellScheduleService bellScheduleService) {
    this.lessonScheduleService = lessonScheduleService;
    this.bellScheduleService = bellScheduleService;
  }

  public String formatDaySchedule(Person person, Day day, String label) {
    int groupNum = person.getGroupNum();
    List<List<String>> lessons = lessonScheduleService.getLessons(groupNum, day);
    if (lessons.isEmpty()) {
      return "Расписание *"
          + groupNum
          + "* группы ("
          + label
          + "):\n\n"
          + MessagesConfig.NO_LESSONS_MESSAGE;
    }

    StringBuilder result =
        new StringBuilder("Расписание *" + groupNum + "* группы\n*" + label + "*\n\n");

    for (List<String> list : lessons) {
      String rawNum = list.get(0) != null ? list.get(0).trim() : "";
      int lessonNum = 0;
      try {
        lessonNum = Integer.parseInt(rawNum.replaceAll("[^0-9]", ""));
      } catch (Exception ignored) {
      }

      String bellTime = lessonNum > 0 ? bellScheduleService.getBellTime(day, lessonNum) : "";

      String displayNum = rawNum.isBlank() ? "0" : rawNum;
      result.append("*").append(displayNum).append(" пара:* ").append(list.get(1)).append("\n");
      if (list.size() > 2 && list.get(2) != null && !list.get(2).isBlank()) {
        result.append("*Кабинет:* ").append(list.get(2)).append("\n");
      }
      if (!bellTime.isBlank()) {
        result.append(person.isMinimalistMode() ? "`" : "⏱ `").append(bellTime).append("`\n");
      }
      result.append("\n");
    }

    return result.toString().trim();
  }

  @Override
  public List<SendMessage> handle(Update update, Person person) {
    person.setInputType(InputType.COMMAND);
    boolean isGroupChat = person.getChatId().startsWith("-");

    String textMessage = update.getMessage().getText().toLowerCase().trim();
    if (textMessage.startsWith("/today")) textMessage = "сегодня";
    else if (textMessage.startsWith("/tomorrow")) textMessage = "завтра";

    try {
      Day day = DayUtil.convertStrToDay(textMessage);

      List<List<String>> lessons = lessonScheduleService.getLessons(person.getGroupNum(), day);

      if (lessons.isEmpty()) {
        CustomMessage noLessons =
            new CustomMessage(person.getChatId(), MessagesConfig.NO_LESSONS_MESSAGE);
        if (!isGroupChat) {
          MainKeyboard.addKeyboard(noLessons, person.isCompactMenu());
        }
        return List.of(noLessons);
      }

      String formatted = formatDaySchedule(person, day, textMessage);
      SendMessage scheduleMessage = new SendMessage(person.getChatId(), formatted);
      scheduleMessage.enableMarkdown(true);
      scheduleMessage.setReplyMarkup(
          ReportKeyboard.getKeyboard(textMessage, person.isMinimalistMode()));

      return List.of(scheduleMessage);
    } catch (Exception e) {
      return List.of(new ErrorMessage(person.getChatId(), e.getMessage()));
    }
  }
}
